PORT=5000
MONGODB_URI=mongodb://localhost:27017/namaste-shop
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
JWT_SECRET=your_jwt_secret_key
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=admin123
NODE_ENV=development
# Configure a local print agent/utility. Arguments must be a JSON array.
# Available tokens: {filePath}, {printerName}, {copies}
PRINTER_NAME=Campus_Printer_01
PRINT_COMMAND=
PRINT_COMMAND_ARGS=[]
PRINT_AGENT_TOKEN=replace-with-a-long-random-token
PRINT_PRINTERS=["Campus_Printer_01"]
PRINT_AGENT_API_URL=http://localhost:5000/api
PRINT_AGENT_POLL_MS=5000
